# Edge Server Environment Variables

# PostgreSQL Configuration
EDGE_POSTGRES_DB=maritime_edge
EDGE_POSTGRES_USER=edge_user
EDGE_POSTGRES_PASSWORD=REPLACE_WITH_EDGE_DB_PASSWORD
EDGE_POSTGRES_PORT=5433

# Vessel identity (IMO, name, MMSI, DWT...) is NOT configured here anymore.
# Single source of truth: DB table `ship_data`, edited via the Edge UI Ship's Data page.
# (Vessel Provisioning v3 — Phase 5b, 2026-07-30.)

# Internal-access / auth secrets
# Keep this key fixed after importing provisioning packages (32 random bytes, Base64).
EDGE_DATA_PROTECTION_KEY=REPLACE_WITH_RANDOM_BASE64_KEY
EDGE_INTERNAL_API_KEY=REPLACE_WITH_EDGE_INTERNAL_API_KEY
EDGE_AUTH_TOKEN_SIGNING_KEY=REPLACE_WITH_EDGE_TOKEN_SIGNING_KEY_MIN_32_CHARS

# Provisioned Shore connection and sync credentials are stored in the
# edge_provisioning_profile table after importing a Shore package.
# Legacy mode is still supported only when EDGE_SYNC_CONFIG_MODE=Legacy
# is set explicitly together with SHORE_API_URL / EDGE_NODE_API_TOKEN /
# EDGE_SYNC_NODE_ID / EDGE_SYNC_SIGNING_KEY.

# Daily application traffic reservations (0 = unlimited; includes retry attempts).
# Pick values from the vessel's measured link and airtime allowance.
EDGE_IRIDIUM_DAILY_BYTES=0
EDGE_VSAT_DAILY_BYTES=0
EDGE_SYNC_CHUNKS_PER_CYCLE=1
EDGE_SYNC_FILES_PER_CYCLE=1

# Optional docker-compose.link.yml: host adapter refreshes this directory's
# active-link.txt at least every 60 seconds. Missing/stale status means offline.
# EDGE_LINK_STATUS_DIRECTORY=D:/maritime-link-status
EDGE_LINK_MAX_AGE_SECONDS=120
